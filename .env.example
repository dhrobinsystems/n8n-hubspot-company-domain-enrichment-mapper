# =============================================================================
# n8n-hubspot-company-domain-enrichment-mapper: environment template
# -----------------------------------------------------------------------------
# Copy to .env (never commit it), replace the {{PLACEHOLDER}} values, and load
# the file into the n8n process (docker-compose env_file, systemd, or your
# secret manager). Validate before deploying:
#
#     node config.validator.js --env-path .env
#
# n8n must let Code nodes read environment variables:
#     N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# If env access stays blocked, the router runs on safe defaults (sandbox on).
#
# DISCLAIMER: provided "AS IS" without warranty. You are responsible for CRM
# data integrity, backups, API rate limits and third-party terms of service.
# =============================================================================

# --- Safety ------------------------------------------------------------------
# true  = fetch, extract and enrich, but only LOG the HubSpot updates (dry run)
# false = live: PATCH HubSpot company records
SANDBOX_MODE=true

# --- Credentials (reference only: configure these in the n8n credential store) --
# These are NOT read by the Code nodes. They document which n8n credentials to create.
# HubSpot App Token credential ......... {{HUBSPOT_ACCESS_TOKEN}}
# HubSpot Developer API credential ..... {{HUBSPOT_DEVELOPER_API_KEY}} / {{HUBSPOT_APP_ID}} (trigger only)
# Header Auth credential (enrichment) .. header name: Authorization, value: Bearer {{ENRICHMENT_API_KEY}}

# --- Inbound webhook (only used by the "Company Created Webhook" entry point) --
# Shared secret HubSpot sends in the header below. Minimum 16 characters.
WEBHOOK_SECRET={{WEBHOOK_SECRET}}
WEBHOOK_SECRET_HEADER=x-webhook-secret
REQUIRE_WEBHOOK_SECRET=true
# Comma-separated HubSpot subscription types accepted from the trigger.
ACCEPTED_EVENT_TYPES=company.creation
MAX_EVENTS_PER_RUN=100

# --- HubSpot -----------------------------------------------------------------
HUBSPOT_API_BASE_URL=https://api.hubapi.com
# Custom company properties written by the router (create them before going live).
HUBSPOT_PROP_TECH_STACK=enriched_tech_stack
HUBSPOT_PROP_INDUSTRY_RAW=enriched_industry_raw
HUBSPOT_PROP_STATUS=enrichment_status
HUBSPOT_PROP_LAST_RUN=enrichment_last_run_at
HUBSPOT_PROP_ROOT_DOMAIN=enrichment_root_domain
HUBSPOT_PROP_SOURCE=enrichment_source

# --- Enrichment provider -----------------------------------------------------
# Request: GET {ENRICHMENT_API_BASE_URL}{ENRICHMENT_API_PATH}?{ENRICHMENT_DOMAIN_PARAM}=<root domain>
ENRICHMENT_API_BASE_URL={{ENRICHMENT_API_BASE_URL}}
ENRICHMENT_API_PATH=/companies/find
ENRICHMENT_DOMAIN_PARAM=domain
# Written to the enrichment_source property.
ENRICHMENT_PROVIDER_NAME=generic
# Optional dot.path to the company object inside the response (blank = auto-detect).
ENRICH_RESPONSE_ROOT=
# Where each field lives in the response. Alternatives separated by "|", first non-empty wins.
ENRICH_PATH_INDUSTRY=category.industry|industry|industry_name
ENRICH_PATH_EMPLOYEES=metrics.employees|employee_count|employees|headcount
ENRICH_PATH_EMPLOYEE_RANGE=metrics.employeesRange|employee_range|size
ENRICH_PATH_TECH=tech|technologies|tech_stack

# --- Mapping policy ----------------------------------------------------------
# How ranges like "51-200" become one number: lower | midpoint | upper
EMPLOYEE_RANGE_STRATEGY=midpoint
TECH_STACK_MAX_ITEMS=50
# Optional extra industry translations, raw text -> HubSpot industry option.
# Example: {"fintech platform":"FINANCIAL_SERVICES","devtools":"COMPUTER_SOFTWARE"}
INDUSTRY_MAP_JSON=
# false = only fill empty fields (recommended). true = replace existing CRM values.
OVERWRITE_EXISTING=false
# true = re-enrich companies already marked ENRICHED.
FORCE_REENRICH=false
# true = write the normalized root domain into `domain` when it is empty.
WRITE_NORMALIZED_DOMAIN=true

# --- Domain rules ------------------------------------------------------------
# Extra multi-part suffixes, comma-separated (e.g. internal.example).
EXTRA_PUBLIC_SUFFIXES=
# Extra root domains never sent for enrichment, comma-separated.
EXTRA_BLOCKED_DOMAINS=

# --- Logging -----------------------------------------------------------------
# false = mask domains in dry-run logs (ex*****.com).
LOG_DOMAINS=true
